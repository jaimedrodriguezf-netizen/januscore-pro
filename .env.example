# Supabase — copy to .env.local and fill from your Supabase project / `supabase start`.
# Public values are safe for the browser; the service role key is server-only.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RLS integration tests (tests/rls). When absent, tests skip cleanly.
# Use the Supabase local DB URL (postgres port from supabase/config.toml).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres